    "def haversine_distance(lat1,lon1,lat2,lon2):\n",
    "    r=6371 #Earth's radius in km\n",
    "    phil,phi2 =np.radias (lat1),np.radius (lat2)\n",
    "    delta_phi=np.radius(lat2_lat1)\n",
    "    delta_Lambda=np.radius(lon2-lon1)\n",
    "    a=np.sin(delta_phi/2)**2+ np.cos(phi1)*np.cos9phi2)*np.sin(delta_lambda/2)**2\n",
    "    res=2*  r* np.arcsin(np.sqnt(a))\n",
    "    return res\n",
    "    \n",
